{
  "name": "afk-cli",
  "version": "0.1.0",
  "description": "Leave a coding agent implementing a feature, one task at a time, while you are away from keyboard",
  "type": "module",
  "packageManager": "pnpm@9.15.1",
  "bin": {
    "afk": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"const fs=require('fs');fs.copyFileSync('src/harness.md','dist/harness.md');fs.chmodSync('dist/cli.js',0o755)\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm test && pnpm typecheck && pnpm lint && pnpm format:check",
    "test": "pnpm run build && vitest run"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
