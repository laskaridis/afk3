{
  "name": "@laskaridis/afk",
  "version": "1.0.1",
  "description": "Leave a coding agent implementing a feature, one task at a time, while you are away from keyboard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laskaridis/afk3.git"
  },
  "bugs": "https://github.com/laskaridis/afk3/issues",
  "homepage": "https://github.com/laskaridis/afk3#readme",
  "type": "module",
  "packageManager": "pnpm@9.15.1",
  "bin": {
    "afk": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/dist-clean.mjs && tsc -p tsconfig.build.json && node scripts/dist-prepare.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm test && pnpm typecheck && pnpm lint && pnpm format:check && pnpm depcheck",
    "test": "pnpm run build && vitest run",
    "test:coverage": "pnpm run build && vitest run --coverage",
    "test:unit": "vitest run test/unit",
    "test:integration": "pnpm run build && vitest run test/integration",
    "depcheck": "depcruise src --config .dependency-cruiser.cjs"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
